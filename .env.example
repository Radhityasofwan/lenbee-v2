# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local tidak boleh di-commit (lihat .gitignore).

# --- Database (wajib) ---
# Aplikasi ini memakai MySQL lokal. Gunakan 127.0.0.1, bukan localhost,
# karena localhost bisa resolve ke IPv6 (::1) yang tidak selalu punya grant.
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/lenbee"

# --- Sesi ---
SESSION_TTL_DAYS="30"
SESSION_COOKIE_NAME="lenbee_session"

# --- Penyimpanan berkas ---
# "local" menyimpan ke STORAGE_LOCAL_DIR. Ganti ke "s3" hanya setelah
# provider object storage diimplementasikan.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"

# --- AI (opsional) ---
# Kosongkan ANTHROPIC_API_KEY dan OPENAI_API_KEY bila tidak ingin memakai fitur AI.
# AI_PROVIDER: auto | anthropic | openai | none
AI_PROVIDER="auto"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="45000"
AI_MAX_OUTPUT_TOKENS="2000"

# --- Unggahan berkas ---
UPLOAD_MAX_BYTES="10485760"
UPLOAD_MAX_FILES="10"

# --- Push notifikasi (opsional, tapi wajib untuk fitur notifikasi HP) ---
# Generate sekali dengan: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY dikirim ke browser (aman, memang publik).
# VAPID_PRIVATE_KEY jangan pernah dibagikan / commit.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@lenbee.id"

# --- Cron reminder harian (opsional) ---
# Header yang harus dikirim endpoint /api/cron/daily-notifications: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
